{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/main.py"
    }
  ],
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1",
    "HF_HOME": "/tmp/huggingface",
    "TRANSFORMERS_CACHE": "/tmp/huggingface",
    "SENTENCE_TRANSFORMERS_HOME": "/tmp/huggingface",
    "TORCH_HOME": "/tmp/torch"
  }
}
